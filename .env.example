NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=*
LOG_LEVEL=info

# Chaves de API por plano (X-API-Key). Troque em produção.
# Em NODE_ENV=production, os planos Pro/Enterprise só são aceitos quando estas
# variáveis estão definidas — os defaults abaixo são desativados nesse cenário.
API_KEY_FREE=brasa-free-key
API_KEY_PRO=brasa-pro-2026
API_KEY_ENTERPRISE=brasa-enterprise-secret

# Limites de requisições por minuto de cada plano
RATE_LIMIT_FREE=60
RATE_LIMIT_PRO=300
RATE_LIMIT_ENTERPRISE=1000

# Fuso horário usado em filtros de data (date=today)
TIME_ZONE=America/Sao_Paulo

# Persistência externa (Upstash Redis). Sem estas variáveis a API roda 100% em memória.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Grava alterações também nos arquivos src/data/*.json (apenas dev local)
PERSIST_CHANGES=false

# Permite webhooks para hosts privados/loopback (APENAS dev/teste local; nunca em produção)
WEBHOOK_ALLOW_PRIVATE_HOSTS=false

# Alertas de prontidão: webhook (Slack/Discord/UptimeRobot/PagerDuty) e cooldown entre alertas
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MS=300000

# Self-check periódico de prontidão no servidor (0 = desativado; serverless não usa)
ALERT_CHECK_INTERVAL_MS=0
