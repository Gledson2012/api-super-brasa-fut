{
  "name": "api-super-brasa-fut",
  "version": "1.0.0",
  "description": "Super Brasa Fut - REST API de Futebol (Brasileirão 2026, Libertadores, Mundial Sub-20, Ligas Europeias, Estatísticas e Resultados ao Vivo)",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/data', 'dist/data', { recursive: true })\"",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/generate-seeds.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "futebol",
    "brasileirao",
    "libertadores",
    "flashscore",
    "sofascore",
    "fbref",
    "api",
    "rest",
    "live-score",
    "football",
    "soccer",
    "sports-api"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
